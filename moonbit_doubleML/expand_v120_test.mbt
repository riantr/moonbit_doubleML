// v0.120.0 -- the regularised learners, checked against scikit-learn 1.9.0.
//
// THIS FILE IS GENERATED by `_verify/_emit_v120_test.py` from
// `_verify/_v120_golden.json`, which `gen_v120_oracle.py` produced by
// actually fitting sklearn. Do not hand-edit the data sections and do
// not hand-type fixtures: the whole value of an external oracle is that
// it saw the same arrays, and that is worthless if the copy drifts.
//
// ---------------------------------------------------------------------------
// TOLERANCES -- each is a measured worst case times a margin
// ---------------------------------------------------------------------------
//
//   Ridge coefficients / intercept   7.06e-14 measured (probe_v120_algo4,
//                                    over every sample_weight regime)
//                                        -> gate 1e-9
//   EN objective, relative           1.21e-07 measured (probe_v120_algo4
//                                    at tol = 1e-10)   -> gate 1e-6
//   EN(l1_ratio = 0) == Ridge        2.50e-07 measured, and essentially all
//                                    of it is the f6_scaled fixture where
//                                    sklearn's OWN reported duality gap is
//                                    3.1e-5, i.e. neither solver reaches
//                                    1e-10 on a design that badly scaled
//                                        -> gate 1e-6
//   Lasso == ElasticNet(l1_ratio=1)  0.0 measured, bit-identical
//                                        -> gate 0.0 exactly
//   sample_weight scale invariance   1.80e-16 measured -> gate 1e-12
//
// ---------------------------------------------------------------------------
// WHY THE ITERATIVE LEARNERS ARE GATED ON THE OBJECTIVE
// ---------------------------------------------------------------------------
//
// At tol = 1e-10, the coefficients of two correct iterative solvers differ
// by up to 8.8e-4 on a linear-convergence design while the objective
// differs by only 4.4e-9 absolute. The objective is flat at the optimum
// and the active set is not, so |F(this) - F(sklearn)| is the statement
// that does not depend on which solver stopped first. `Ridge` is closed
// form and IS gated coefficient-wise at 1e-9.
//
// A gate that would have proved nothing: comparing coefficients at
// sklearn's default tol = 1e-4. Measured gaps reach 5.06e-1 there, so
// such a gate is either vacuous or so loose it catches nothing.

///|
/// Build a `Matrix` from row literals. `Matrix`'s fields are module
/// private, so a blackbox test file has to go through the constructors.
fn v120_matrix(rows : Array[Array[Double]]) -> Matrix {
  Matrix::from_rows(rows)
}

///|
/// Largest absolute gap between two equal-length vectors. A length
/// mismatch ABORTS rather than comparing a prefix: a shape drift must
/// fail loudly, never read as agreement.
fn v120_max_abs_diff(a : Array[Double], b : Array[Double]) -> Double {
  if a.length() != b.length() {
    abort(
      "v120_max_abs_diff: length " +
      b.length().to_string() +
      " != " +
      a.length().to_string(),
    )
  }
  let mut worst = 0.0
  for i = 0; i < a.length(); i = i + 1 {
    let d = (a[i] - b[i]).abs()
    if d > worst {
      worst = d
    }
  }
  worst
}

///|
/// Relative gap, scaled so a zero-magnitude reference cannot divide by
/// zero into an infinity.
fn v120_rel_diff(actual : Double, expected : Double) -> Double {
  let scale = if expected.abs() > 1.0e-300 { expected.abs() } else { 1.0 }
  (actual - expected).abs() / scale
}

///|
/// The means `Lasso` / `ElasticNet` central on: the WEIGHTED column means
/// when weights are supplied, the plain means otherwise. This mirrors
/// `reg_fit_means` deliberately, so the un-penalised-intercept identity
/// can be checked from OUTSIDE the fit rather than trusting the fit to
/// report its own arithmetic as correct.
fn v120_means(
  x : Matrix,
  y : Array[Double],
  sw : Array[Double],
) -> (Array[Double], Double) {
  let n = x.rows()
  let p = x.cols()
  let weighted = sw.length() > 0
  let mut total = 0.0
  for i = 0; i < n; i = i + 1 {
    total = total + (if weighted { sw[i] } else { 1.0 })
  }
  let denom = if weighted { total } else { n.to_double() }
  let xm = Array::make(p, 0.0)
  let mut yacc = 0.0
  for i = 0; i < n; i = i + 1 {
    let wi = if weighted { sw[i] } else { 1.0 }
    yacc = yacc + wi * y[i]
    for j = 0; j < p; j = j + 1 {
      xm[j] = xm[j] + wi * x.get(i, j)
    }
  }
  for j = 0; j < p; j = j + 1 {
    xm[j] = xm[j] / denom
  }
  (xm, yacc / denom)
}

///|
/// Indices at which `v` is NONZERO -- the Lasso support, matching
/// sklearn's `nnz` / nonzero-mask convention. This is a DISCRETE
/// property that does not wobble with the stopping rule, so unlike the
/// coefficient VALUES it can be gated exactly. An earlier version of
/// this helper returned the ZERO indices instead, which made its length
/// `p - nnz` and quietly compared the wrong thing.
fn v120_support(v : Array[Double]) -> Array[Int] {
  let idx = []
  for i = 0; i < v.length(); i = i + 1 {
    if v[i] != 0.0 {
      idx.push(i)
    }
  }
  idx
}

///|
/// Assert-with-message. A bare failure in a 300-row fixture sweep says
/// only "somewhere in here"; this prints the two numbers so the failing
/// row is identifiable without a debugger.
fn v120_close(actual : Double, expected : Double, tol : Double) -> Bool {
  let d = (actual - expected).abs()
  if d <= tol {
    true
  } else {
    println(
      "  v120 mismatch: actual=" +
      actual.to_string() +
      " expected=" +
      expected.to_string() +
      " |d|=" +
      d.to_string() +
      " tol=" +
      tol.to_string(),
    )
    false
  }
}

///|
/// Assert-with-message, usable from a HELPER function. `assert_true`
/// returns an error type and so may only appear inside a `test` block,
/// which is why the fixture loops below call this instead: a bare abort
/// in a helper would say only that something failed, not which gate.
fn v120_expect(ok : Bool, what : String) -> Unit {
  if !ok {
    abort("v120 gate failed: " + what)
  }
}

