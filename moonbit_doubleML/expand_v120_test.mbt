///|
/// f6_scaled: design, response, weights, sklearn's Ridge reference.
fn v120_f6_scaled_data_with_ridge() -> (
  Matrix,
  Array[Double],
  Array[Double],
  Array[Double],
) {
  let (x, y, sw) = v120_f6_scaled_data()
  (x, y, sw, v120_f6_scaled_ridge_ref())
}

///|
/// f6_scaled: design, response, weights, sklearn's ElasticNet reference.
fn v120_f6_scaled_data_with_enet() -> (
  Matrix,
  Array[Double],
  Array[Double],
  Array[Double],
) {
  let (x, y, sw) = v120_f6_scaled_data()
  (x, y, sw, v120_f6_scaled_enet_ref())
}

///|
/// Number of Ridge reference cases per fixture.
const N_RIDGE_CASES : Int = 3

///|
/// Number of ElasticNet reference cases per fixture.
const N_ENET_CASES : Int = 5

///|
/// Solver tolerance sklearn was fitted with, and this package
/// matches. Both sides must use the same value: comparing a
/// tol=1e-4 solve against a tol=1e-10 one compares stopping
/// rules, not models.
const V120_TOL : Double = 1.0e-10

///|
const V120_MAX_ITER : Int = 1000000

///|
/// `cross_fit_predict_dispatch` wants folds. A deterministic
/// contiguous partition: enough to prove the plumbing, without
/// depending on a shuffle whose seed is not part of this gate.
fn v120_kfold_folds(n : Int, k : Int) -> Array[Fold] {
  let out : Array[Fold] = []
  for f = 0; f < k; f = f + 1 {
    let test_lo = n * f / k
    let test_hi = n * (f + 1) / k
    let train_idx : Array[Int] = []
    for i = 0; i < n; i = i + 1 {
      if i < test_lo || i >= test_hi {
        train_idx.push(i)
      }
    }
    let test_idx : Array[Int] = []
    for i = test_lo; i < test_hi; i = i + 1 {
      test_idx.push(i)
    }
    out.push(Fold::new(train_idx, test_idx))
  }
  out
}

///|
/// Fold `x`, `y`, `sw` and every sklearn Ridge reference into one pass,
/// returning the worst coefficient gap seen. One helper called once per
/// fixture rather than an array of closures: `Array[fn]` inside a type
/// argument does not parse, and seven explicit calls read better anyway.
fn v120_check_ridge(
  x : Matrix,
  y : Array[Double],
  sw : Array[Double],
  refs : Array[Double],
) -> Double {
  let p = x.cols()
  let mut worst = 0.0
  for c = 0; c < N_RIDGE_CASES; c = c + 1 {
    let base = c * (p + 2)
    let alpha = refs[base]
    let expect = Array::make(p, 0.0)
    for j = 0; j < p; j = j + 1 {
      expect[j] = refs[base + 1 + j]
    }
    let got = Ridge::new(alpha~).fit_weighted(x, y, sw)
    let d = v120_max_abs_diff(got.coefficients(), expect)
    if d > worst {
      worst = d
    }
    v120_expect(
      v120_close(got.intercept(), refs[base + 1 + p], 1.0e-9),
      "ridge intercept vs sklearn",
    )
    v120_expect(d <= 1.0e-9, "ridge coefficient gap vs sklearn")
  }
  worst
}

///|
/// The ElasticNet counterpart of `v120_check_ridge`. Gates the
/// OBJECTIVE (relative) and the support (exactly).
fn v120_check_enet(
  x : Matrix,
  y : Array[Double],
  sw : Array[Double],
  refs : Array[Double],
) -> Double {
  let p = x.cols()
  let mut worst = 0.0
  for c = 0; c < N_ENET_CASES; c = c + 1 {
    let base = c * (p + 5)
    let alpha = refs[base]
    let l1r = refs[base + 1]
    let expect = Array::make(p, 0.0)
    for j = 0; j < p; j = j + 1 {
      expect[j] = refs[base + 2 + j]
    }
    let expect_obj = refs[base + 2 + p + 1]
    let expect_nnz = refs[base + 2 + p + 2]
    let got = ElasticNet::new(
      alpha~,
      l1_ratio=l1r,
      tol=V120_TOL,
      max_iter=V120_MAX_ITER,
    ).fit_weighted(x, y, sw)
    let got_obj = enet_objective(got.coefficients(), x, y, sw, alpha, l1r)
    let rel = v120_rel_diff(got_obj, expect_obj)
    if rel > worst {
      worst = rel
    }
    if rel > 1.0e-6 {
      println(
        "  enet rel=" +
        rel.to_string() +
        " alpha=" +
        alpha.to_string() +
        " l1_ratio=" +
        l1r.to_string() +
        " expected_obj=" +
        expect_obj.to_string() +
        " got_obj=" +
        got_obj.to_string(),
      )
    }
    v120_expect(rel <= 1.0e-6, "elastic net objective gap vs sklearn")
    let got_sup = v120_support(got.coefficients())
    let exp_sup = v120_support(expect)
    v120_expect(got_sup == exp_sup, "elastic net support vs sklearn")
    v120_expect(
      got_sup.length().to_double() == expect_nnz,
      "elastic net nnz vs sklearn",
    )
  }
  worst
}

// ---------------------------------------------------------------------------
// GATE 1 -- Ridge against sklearn, coefficient-wise. Closed form, so this
// can be tight: measured worst case 7.06e-14 over every weight regime.
// ---------------------------------------------------------------------------

///|
test "v120_ridge_matches_sklearn_coefficients" {
  let (x0, y0, w0, r0) = v120_f0_tiny_data_with_ridge()
  let (x1, y1, w1, r1) = v120_f1_collinear_data_with_ridge()
  let (x2, y2, w2, r2) = v120_f2_p_gt_n_data_with_ridge()
  let (x3, y3, w3, r3) = v120_f3_warm_data_with_ridge()
  let (x4, y4, w4, r4) = v120_f4_weighted_data_with_ridge()
  let (x5, y5, w5, r5) = v120_f5_hard_data_with_ridge()
  let (x6, y6, w6, r6) = v120_f6_scaled_data_with_ridge()
  let mut worst = v120_check_ridge(x0, y0, w0, r0)
  let a = v120_check_ridge(x1, y1, w1, r1)
  if a > worst {
    worst = a
  }
  let a = v120_check_ridge(x2, y2, w2, r2)
  if a > worst {
    worst = a
  }
  let a = v120_check_ridge(x3, y3, w3, r3)
  if a > worst {
    worst = a
  }
  let a = v120_check_ridge(x4, y4, w4, r4)
  if a > worst {
    worst = a
  }
  let a = v120_check_ridge(x5, y5, w5, r5)
  if a > worst {
    worst = a
  }
  let a = v120_check_ridge(x6, y6, w6, r6)
  if a > worst {
    worst = a
  }
  println("ridge worst coefficient gap = " + worst.to_string())
}

// ---------------------------------------------------------------------------
// GATE 2 -- ElasticNet against sklearn on the OBJECTIVE, support exactly.
// ---------------------------------------------------------------------------

///|
test "v120_elastic_net_objective_matches_sklearn" {
  let (x0, y0, w0, r0) = v120_f0_tiny_data_with_enet()
  let (x1, y1, w1, r1) = v120_f1_collinear_data_with_enet()
  let (x2, y2, w2, r2) = v120_f2_p_gt_n_data_with_enet()
  let (x3, y3, w3, r3) = v120_f3_warm_data_with_enet()
  let (x4, y4, w4, r4) = v120_f4_weighted_data_with_enet()
  let (x5, y5, w5, r5) = v120_f5_hard_data_with_enet()
  let (x6, y6, w6, r6) = v120_f6_scaled_data_with_enet()
  let mut worst = v120_check_enet(x0, y0, w0, r0)
  let a = v120_check_enet(x1, y1, w1, r1)
  if a > worst {
    worst = a
  }
  let a = v120_check_enet(x2, y2, w2, r2)
  if a > worst {
    worst = a
  }
  let a = v120_check_enet(x3, y3, w3, r3)
  if a > worst {
    worst = a
  }
  let a = v120_check_enet(x4, y4, w4, r4)
  if a > worst {
    worst = a
  }
  let a = v120_check_enet(x5, y5, w5, r5)
  if a > worst {
    worst = a
  }
  let a = v120_check_enet(x6, y6, w6, r6)
  if a > worst {
    worst = a
  }
  println("elastic net worst relative objective gap = " + worst.to_string())
}

// ---------------------------------------------------------------------------
// GATE 3 -- Lasso IS ElasticNet with l1_ratio = 1. Not "close to": the
// oracle measured a 0.0 gap, because `Lasso::fit_weighted` delegates.
// A second copy of the solver would make this fail, which is the point
// -- it is the canary for the v0.119.0 duplicate-formula bug shape.
// ---------------------------------------------------------------------------

///|
test "v120_lasso_is_exactly_elastic_net_with_l1_ratio_one" {
  let (x, y, sw, _) = v120_f4_weighted_data_with_enet()
  let ls = Lasso::new(alpha=0.1, tol=V120_TOL, max_iter=V120_MAX_ITER).fit_weighted(
    x, y, sw,
  )
  let en = ElasticNet::new(
    alpha=0.1,
    l1_ratio=1.0,
    tol=V120_TOL,
    max_iter=V120_MAX_ITER,
  ).fit_weighted(x, y, sw)
  v120_expect(
    v120_max_abs_diff(ls.coefficients(), en.coefficients()) == 0.0,
    "lasso is exactly elastic net at l1_ratio 1",
  )
  v120_expect(
    ls.intercept() == en.intercept(),
    "lasso and elastic net agree on the intercept",
  )
  v120_expect(
    ls.iterations() == en.iterations(),
    "lasso and elastic net agree on the sweep count",
  )
}

// ---------------------------------------------------------------------------
// GATE 4 -- ElasticNet with l1_ratio = 0 is Ridge with
// `alpha = a * sum(sample_weight)`.
//
// The `sum(sample_weight)` is the non-obvious half. The unweighted-only
// form `a * n` is wrong by 2.1e-1 on the weighted fixture; the oracle
// found that, which is why the factor is stated rather than left as
// "they should be the same model".
// ---------------------------------------------------------------------------

///|
fn v120_check_l1_ratio_zero(
  x : Matrix,
  y : Array[Double],
  sw : Array[Double],
) -> Double {
  let mut total = 0.0
  for i = 0; i < x.rows(); i = i + 1 {
    total = total + (if sw.length() > 0 { sw[i] } else { 1.0 })
  }
  let mut worst = 0.0
  for ai = 0; ai < 3; ai = ai + 1 {
    let alpha = if ai == 0 { 0.05 } else if ai == 1 { 0.7 } else { 5.0 }
    let en = ElasticNet::new(
      alpha~,
      l1_ratio=0.0,
      tol=1.0e-14,
      max_iter=20000000,
    ).fit_weighted(x, y, sw)
    let rg = Ridge::new(alpha=alpha * total).fit_weighted(x, y, sw)
    let d = v120_max_abs_diff(en.coefficients(), rg.coefficients())
    if d > worst {
      worst = d
    }
    let tight = ElasticNet::new(
      alpha~,
      l1_ratio=0.0,
      tol=1.0e-14,
      max_iter=20000000,
    ).fit_weighted(x, y, sw)
    let d_tight = v120_max_abs_diff(tight.coefficients(), rg.coefficients())
    println(
      "  l1r0 n=" +
      x.rows().to_string() +
      " p=" +
      x.cols().to_string() +
      " alpha=" +
      alpha.to_string() +
      " gap@1e-10=" +
      d.to_string() +
      " gap@1e-14=" +
      d_tight.to_string() +
      " iters=" +
      en.iterations().to_string() +
      "/" +
      tight.iterations().to_string(),
    )
    v120_expect(d <= 1.0e-5, "l1_ratio=0 coefficients vs ridge")
    v120_expect(
      (en.intercept() - rg.intercept()).abs() <= 1.0e-6,
      "l1_ratio=0 intercept vs ridge",
    )
  }
  worst
}

///|
test "v120_elastic_net_l1_ratio_zero_is_ridge_at_a_times_sum_weight" {
  let (x0, y0, w0) = v120_f0_tiny_data()
  let (x1, y1, w1) = v120_f1_collinear_data()
  let (x4, y4, w4) = v120_f4_weighted_data()
  let mut worst = v120_check_l1_ratio_zero(x0, y0, w0)
  let a = v120_check_l1_ratio_zero(x1, y1, w1)
  if a > worst {
    worst = a
  }
  let a = v120_check_l1_ratio_zero(x4, y4, w4)
  if a > worst {
    worst = a
  }
  println("l1_ratio=0 identity worst gap = " + worst.to_string())
}

// ---------------------------------------------------------------------------
// GATE 5 -- the intercept is UNPENALISED and is recovered from the centred
// fit rather than carried as a column of X. This is the gate for the
// tempting mistake: `LinearRegression` folds the intercept into the design
// as a leading column of ones, and doing the same here penalises it. The
// two intercepts differ by 2.7e-2 on the oracle fixture.
// ---------------------------------------------------------------------------

///|
fn v120_check_unpenalised_intercept(
  x : Matrix,
  y : Array[Double],
  sw : Array[Double],
) -> Unit {
  let (xm, ym) = v120_means(x, y, sw)
  let rg = Ridge::new(alpha=0.7).fit_weighted(x, y, sw)
  let l1 = Lasso::new(alpha=0.1, tol=V120_TOL, max_iter=V120_MAX_ITER).fit_weighted(
    x, y, sw,
  )
  let en = ElasticNet::new(
    alpha=0.1,
    l1_ratio=0.5,
    tol=V120_TOL,
    max_iter=V120_MAX_ITER,
  ).fit_weighted(x, y, sw)
  let mut w0 = ym
  let mut w1 = ym
  let mut w2 = ym
  for j = 0; j < x.cols(); j = j + 1 {
    w0 = w0 - xm[j] * rg.coefficients()[j]
    w1 = w1 - xm[j] * l1.coefficients()[j]
    w2 = w2 - xm[j] * en.coefficients()[j]
  }
  v120_expect(
    (rg.intercept() - w0).abs() <= 1.0e-9,
    "ridge intercept is the unpenalised one",
  )
  v120_expect(
    (l1.intercept() - w1).abs() <= 1.0e-9,
    "lasso intercept is the unpenalised one",
  )
  v120_expect(
    (en.intercept() - w2).abs() <= 1.0e-9,
    "elastic net intercept is the unpenalised one",
  )
  // when weights are present the centroid really is the WEIGHTED mean
  if sw.length() > 0 {
    let mut plain = 0.0
    for v in y {
      plain = plain + v
    }
    plain = plain / y.length().to_double()
    v120_expect(
      (ym - plain).abs() > 0.0,
      "centroid is the weighted mean, not the plain one",
    )
  }
}

///|
test "v120_intercept_is_unpenalised_and_recovered_from_the_centred_fit" {
  let (x0, y0, w0) = v120_f0_tiny_data()
  let (x1, y1, w1) = v120_f1_collinear_data()
  let (x4, y4, w4) = v120_f4_weighted_data()
  v120_check_unpenalised_intercept(x0, y0, w0)
  v120_check_unpenalised_intercept(x1, y1, w1)
  v120_check_unpenalised_intercept(x4, y4, w4)
}

// ---------------------------------------------------------------------------
// GATE 6 -- sample_weight scale invariance for the L1/L2 family. They
// renormalise the weights to mean 1, so `w` and `17 * w` must agree.
// `Ridge` is NOT scale invariant (alpha is absolute there), so this gate
// is scoped to the iterative learners on purpose. Do not "fix" one
// family to match the other.
// ---------------------------------------------------------------------------

///|
test "v120_elastic_net_is_invariant_to_a_global_rescaling_of_sample_weight" {
  let (x, y, sw) = v120_f4_weighted_data()
  let big = Array::make(x.rows(), 0.0)
  for i = 0; i < x.rows(); i = i + 1 {
    big[i] = sw[i] * 17.0
  }
  let a = ElasticNet::new(
    alpha=0.1,
    l1_ratio=0.5,
    tol=V120_TOL,
    max_iter=V120_MAX_ITER,
  ).fit_weighted(x, y, sw)
  let b = ElasticNet::new(
    alpha=0.1,
    l1_ratio=0.5,
    tol=V120_TOL,
    max_iter=V120_MAX_ITER,
  ).fit_weighted(x, y, big)
  v120_expect(
    v120_max_abs_diff(a.coefficients(), b.coefficients()) <= 1.0e-12,
    "elastic net is invariant to a weight rescaling",
  )
  v120_expect(
    (a.intercept() - b.intercept()).abs() <= 1.0e-12,
    "elastic net intercept is invariant to a weight rescaling",
  )
}

// ---------------------------------------------------------------------------
// GATE 7 -- uniform weights are a no-op. This is the v0.118.0
// `sample_weight` contract ("an empty array means unweighted") carried
// through: an array of ones must reach the same answer as no array.
// ---------------------------------------------------------------------------

///|
test "v120_uniform_sample_weight_equals_no_sample_weight" {
  let (x, y, _) = v120_f3_warm_data()
  let ones = Array::make(x.rows(), 1.0)
  let r0 = Ridge::new(alpha=0.7).fit(x, y)
  let r1 = Ridge::new(alpha=0.7).fit_weighted(x, y, ones)
  v120_expect(
    v120_max_abs_diff(r0.coefficients(), r1.coefficients()) <= 1.0e-12,
    "ridge: uniform weights equal no weights",
  )
  v120_expect(
    (r0.intercept() - r1.intercept()).abs() <= 1.0e-12,
    "ridge intercept: uniform weights equal no weights",
  )
  let l0 = Lasso::new(alpha=0.1, tol=V120_TOL, max_iter=V120_MAX_ITER).fit(x, y)
  let l1 = Lasso::new(alpha=0.1, tol=V120_TOL, max_iter=V120_MAX_ITER).fit_weighted(
    x, y, ones,
  )
  v120_expect(
    v120_max_abs_diff(l0.coefficients(), l1.coefficients()) <= 1.0e-12,
    "lasso: uniform weights equal no weights",
  )
  v120_expect(
    (l0.intercept() - l1.intercept()).abs() <= 1.0e-12,
    "lasso intercept: uniform weights equal no weights",
  )
}

// ---------------------------------------------------------------------------
// GATE 8 -- `predict` is exactly the affine map it documents, for all
// three, including the weighted fit.
// ---------------------------------------------------------------------------

///|
test "v120_predict_is_the_affine_map_it_documents" {
  let (x, y, sw) = v120_f4_weighted_data()
  let rg = Ridge::new(alpha=0.7).fit_weighted(x, y, sw)
  let ls = Lasso::new(alpha=0.1, tol=V120_TOL, max_iter=V120_MAX_ITER).fit_weighted(
    x, y, sw,
  )
  let en = ElasticNet::new(
    alpha=0.1,
    l1_ratio=0.5,
    tol=V120_TOL,
    max_iter=V120_MAX_ITER,
  ).fit_weighted(x, y, sw)
  let pr = rg.predict(x)
  let pl = ls.predict(x)
  let pe = en.predict(x)
  for i = 0; i < x.rows(); i = i + 1 {
    let mut a = rg.intercept()
    let mut b = ls.intercept()
    let mut c = en.intercept()
    for j = 0; j < x.cols(); j = j + 1 {
      let xv = x.get(i, j)
      a = a + xv * rg.coefficients()[j]
      b = b + xv * ls.coefficients()[j]
      c = c + xv * en.coefficients()[j]
    }
    v120_expect((pr[i] - a).abs() <= 1.0e-12, "ridge predict is the affine map")
    v120_expect((pl[i] - b).abs() <= 1.0e-12, "lasso predict is the affine map")
    v120_expect(
      (pe[i] - c).abs() <= 1.0e-12,
      "elastic net predict is the affine map",
    )
  }
}

// ---------------------------------------------------------------------------
// GATE 9 -- alpha moves the model the way the sign says it must. A larger
// penalty cannot produce a larger L1 coefficient norm on a fixed design.
// This is a sign check, so it catches a dropped or doubled alpha that a
// fixture comparison could in principle absorb.
// ---------------------------------------------------------------------------

///|
test "v120_larger_alpha_shrinks_the_elastic_net_coefficients" {
  let (x, y, sw) = v120_f1_collinear_data()
  let mut prev = 1.0e300
  let mut strict_steps = 0
  let mut first = 0.0
  for ai = 0; ai < 5; ai = ai + 1 {
    let alpha = if ai == 0 {
      0.02
    } else if ai == 1 {
      0.1
    } else if ai == 2 {
      0.5
    } else if ai == 3 {
      2.0
    } else {
      8.0
    }
    let m = ElasticNet::new(
      alpha~,
      l1_ratio=0.5,
      tol=V120_TOL,
      max_iter=V120_MAX_ITER,
    ).fit_weighted(x, y, sw)
    let mut n1 = 0.0
    for c in m.coefficients() {
      n1 = n1 + c.abs()
    }
    println(
      "  l1norm alpha=" +
      alpha.to_string() +
      " n1=" +
      n1.to_string() +
      " iters=" +
      m.iterations().to_string(),
    )
    // NON-increasing is the property that actually holds. Strictly
    // decreasing does NOT: past a large enough alpha the exact optimum
    // IS the all-zero vector, so consecutive norms tie at the floor
    // (measured here: alpha = 2 and alpha = 8 both give exactly 0).
    v120_expect(n1 <= prev, "larger alpha never increases the l1 norm")
    if ai == 0 {
      first = n1
    }
    if n1 < prev {
      strict_steps = strict_steps + 1
    }
    prev = n1
  }
  // ...and the sequence is not vacuously flat. A gate that only checked
  // `n1 <= prev` would pass on a learner that ignored alpha entirely.
  v120_expect(strict_steps >= 3, "alpha actually moves the elastic net")
  v120_expect(first > 0.0, "the smallest alpha does not already zero the fit")
}

// ---------------------------------------------------------------------------
// GATE 10 -- the learners are reachable from the DML plumbing. A new
// `Learner` that is not wired into `LearnerDispatch` is a private helper
// pretending to be a feature. This exercises cross_fit_predict_dispatch,
// fit_predict_one_dispatch and double_cross_fit_predict_dispatch, plus
// sample_weight forwarding through the first.
// ---------------------------------------------------------------------------

///|
test "v120_regularised_learners_reach_every_dispatch_site" {
  let (x, y, _) = v120_f3_warm_data()
  let folds = v120_kfold_folds(x.rows(), 3)
  let ridge = LearnerDispatch::ridge(Ridge::new(alpha=0.7))
  let lasso = LearnerDispatch::lasso(
    Lasso::new(alpha=0.1, tol=V120_TOL, max_iter=V120_MAX_ITER),
  )
  let enet = LearnerDispatch::elastic_net(
    ElasticNet::new(
      alpha=0.1,
      l1_ratio=0.5,
      tol=V120_TOL,
      max_iter=V120_MAX_ITER,
    ),
  )
  let ones = Array::make(x.rows(), 1.0)
  let d0 = cross_fit_predict_dispatch(ridge, x, y, folds)
  let d1 = cross_fit_predict_dispatch(lasso, x, y, folds)
  let d2 = cross_fit_predict_dispatch(enet, x, y, folds)
  v120_expect(d0.length() == x.rows(), "v120 gate")
  v120_expect(d1.length() == x.rows(), "v120 gate")
  v120_expect(d2.length() == x.rows(), "v120 gate")
  let w0 = cross_fit_predict_dispatch(ridge, x, y, folds, sample_weight=ones)
  v120_expect(w0.length() == x.rows(), "v120 gate")
  let o0 = fit_predict_one_dispatch(ridge, x, y, x)
  let o1 = fit_predict_one_dispatch(lasso, x, y, x)
  let o2 = fit_predict_one_dispatch(enet, x, y, x)
  v120_expect(o0.length() == x.rows(), "v120 gate")
  v120_expect(o1.length() == x.rows(), "v120 gate")
  v120_expect(o2.length() == x.rows(), "v120 gate")
  // The double cross-fit returns one PREDICTION VECTOR PER OUTER FOLD,
  // not one vector of rows: the outer dimension is `folds.length()` and
  // each inner vector is length `x.rows()`.
  let c0 = double_cross_fit_predict_dispatch(ridge, x, y, folds, 2, 99)
  let c1 = double_cross_fit_predict_dispatch(lasso, x, y, folds, 2, 99)
  let c2 = double_cross_fit_predict_dispatch(enet, x, y, folds, 2, 99)
  v120_expect(
    c0.length() == folds.length(),
    "ridge double cross-fit: one vector per outer fold",
  )
  v120_expect(
    c1.length() == folds.length(),
    "lasso double cross-fit: one vector per outer fold",
  )
  v120_expect(
    c2.length() == folds.length(),
    "elastic net double cross-fit: one vector per outer fold",
  )
  // Each inner vector is indexed by the OUTER fold's training rows, so
  // its length is that fold's train count, NOT n. With n = 60 and 3
  // outer folds that is 40.
  for k = 0; k < c0.length(); k = k + 1 {
    let want = folds[k].train_indices().length()
    v120_expect(
      c0[k].length() == want,
      "ridge double cross-fit inner vector is the outer train slice",
    )
    v120_expect(
      c1[k].length() == want,
      "lasso double cross-fit inner vector is the outer train slice",
    )
    v120_expect(
      c2[k].length() == want,
      "elastic net double cross-fit inner vector is the outer train slice",
    )
  }
}

// ---------------------------------------------------------------------------
// GATE 11 -- alpha is part of the memoize key. `learner_dispatch_tag`
// deliberately omits the tree learners' tunables; that reasoning does
// not hold for the regularised learners, where alpha DEFINES the model.
// Two alphas sharing a cache key would make the second estimator read
// the first one's cached nuisance predictions and report a silently
// wrong coefficient.
// ---------------------------------------------------------------------------

///|
test "v120_regularisation_strength_is_part_of_the_fit_cache_key" {
  let base = LearnerDispatch::ridge(Ridge::new(alpha=0.05))
  let a = hash_hyperparams("dml_plr", base, base, 1.0e-6)
  let b = hash_hyperparams(
    "dml_plr",
    LearnerDispatch::ridge(Ridge::new(alpha=0.7)),
    base,
    1.0e-6,
  )
  let c = hash_hyperparams(
    "dml_plr",
    LearnerDispatch::lasso(Lasso::new(alpha=0.05)),
    base,
    1.0e-6,
  )
  let d = hash_hyperparams(
    "dml_plr",
    LearnerDispatch::elastic_net(ElasticNet::new(alpha=0.05, l1_ratio=0.5)),
    base,
    1.0e-6,
  )
  let e = hash_hyperparams(
    "dml_plr",
    LearnerDispatch::elastic_net(ElasticNet::new(alpha=0.05, l1_ratio=0.9)),
    base,
    1.0e-6,
  )
  v120_expect(a != b, "v120 gate")
  v120_expect(a != c, "v120 gate")
  v120_expect(a != d, "v120 gate")
  v120_expect(d != e, "v120 gate")
}

// ---------------------------------------------------------------------------
// GATE 12 -- guards. Ridge needs alpha > 0 or the normal equations go
// singular; l1_ratio outside [0, 1] is not a convex blend of anything.
// The `panic_` prefix is this package's convention for a test whose
// EXPECTED outcome is the abort (see aggregator_test.mbt), so the
// framework reports the abort as a pass rather than a crash.
// ---------------------------------------------------------------------------

///|
test "panic_v120_ridge_rejects_a_nonpositive_alpha" {
  let (x, y, _) = v120_f0_tiny_data()
  let _ = Ridge::new(alpha=0.0).fit(x, y)
}

///|
test "panic_v120_ridge_rejects_a_negative_alpha" {
  let (x, y, _) = v120_f0_tiny_data()
  let _ = Ridge::new(alpha=-1.0).fit(x, y)
}

///|
test "panic_v120_elastic_net_rejects_l1_ratio_above_one" {
  let (x, y, _) = v120_f0_tiny_data()
  let _ = ElasticNet::new(alpha=0.1, l1_ratio=1.5).fit(x, y)
}

///|
test "panic_v120_elastic_net_rejects_l1_ratio_below_zero" {
  let (x, y, _) = v120_f0_tiny_data()
  let _ = ElasticNet::new(alpha=0.1, l1_ratio=-0.5).fit(x, y)
}

///|
test "panic_v120_ridge_rejects_a_weight_array_of_the_wrong_length" {
  let (x, y, _) = v120_f0_tiny_data()
  let short = Array::make(x.rows() - 1, 1.0)
  let _ = Ridge::new(alpha=0.7).fit_weighted(x, y, short)
}

///|
test "panic_v120_lasso_rejects_a_negative_sample_weight" {
  let (x, y, _) = v120_f0_tiny_data()
  let bad = Array::make(x.rows(), 1.0)
  bad[0] = -1.0
  let _ = Lasso::new(alpha=0.1, tol=V120_TOL, max_iter=V120_MAX_ITER).fit_weighted(
    x, y, bad,
  )
}
