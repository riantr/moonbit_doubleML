///|
/// f4_weighted: design, response, weights, sklearn's Ridge reference.
fn v120_f4_weighted_data_with_ridge() -> (
  Matrix,
  Array[Double],
  Array[Double],
  Array[Double],
) {
  let (x, y, sw) = v120_f4_weighted_data()
  (x, y, sw, v120_f4_weighted_ridge_ref())
}

