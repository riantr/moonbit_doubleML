// v0.121.0 -- the propensity processor becomes reachable from an
// estimator, checked against upstream doubleml 0.11.4.
//
// THIS FILE IS GENERATED by `_verify/_emit_v121_test.py` from
// `_verify/_v121_golden.json`, which `gen_v121_oracle.py` produced by
// calling UPSTREAM's own
// `doubleml/utils/propensity_score_processing.py::init_ps_processor`
// and `PSProcessor.adjust_ps`. Do not hand-edit the data.
//
// ---------------------------------------------------------------------------
// WHAT THIS ROUND FIXED
// ---------------------------------------------------------------------------
//
// `PSProcessorConfig` has carried `calibration_method` ("none" |
// "isotonic") and `cv_calibration` since v0.48.0. NO estimator
// accepted a `PSProcessorConfig`, so those paths were unreachable dead
// code: every estimator took a scalar `propensity_clip` and inlined
// `clip_vec(m, clip, 1 - clip)` itself, in twelve separate places.
//
// Twelve upstream estimators call `init_ps_processor` (apo, apos, cvar,
// iivm, irm, lpq, pq, qte, ssm, did_binary, did_cs_binary, did_multi).
// This release ports that function and wires it through APO/APOS.
//
// ---------------------------------------------------------------------------
// MEASURED FACTS, each pinned below
// ---------------------------------------------------------------------------
//
//   * init_ps_processor precedence is "THE CONFIG WINS OUTRIGHT", not a
//     merge and not a per-field fallback:
//         init_ps_processor(cfg(clip=0.3), "truncate", 0.05) -> clip 0.3
//     The deprecated scalar is read into the config ONLY when no config
//     is present. Gate: v121_resolution_precedence.
//
//   * The calibration is a NO-OP without a method, EXACTLY:
//         max |adjust_ps(ps, d) - ps| = 0.0     for method = "none"
//     on the fixture's interior rows. That is what makes routing the
//     pre-existing inline clip site through `adjust_ps`
//     behaviour-preserving. Gate: v121_no_calibration_is_exact_identity.
//
//   * Isotonic calibration is NOT cosmetic. It moves the propensity by
//     up to 0.526 on these fixtures, and `cv_calibration` moves it
//     differently again (0.378 vs 0.423 on the same array). Gates:
//     v121_isotonic_moves_the_propensity, v121_cv_calibration_differs.
//
//   * `cv_calibration = True` without a calibration method is REJECTED
//     upstream ("cv_calibration=True requires a calibration_method.").
//     Gate: v121_cv_calibration_requires_a_method.

///|
fn v121_max_abs_diff(a : Array[Double], b : Array[Double]) -> Double {
  if a.length() != b.length() {
    abort(
      "v121_max_abs_diff: length " +
      b.length().to_string() +
      " != " +
      a.length().to_string(),
    )
  }
  let mut worst = 0.0
  for i = 0; i < a.length(); i = i + 1 {
    let d = (a[i] - b[i]).abs()
    if d > worst {
      worst = d
    }
  }
  worst
}

///|
/// Assert-with-message. `assert_true` returns an error type and so may
/// only appear inside a `test` block.
fn v121_expect(ok : Bool, what : String) -> Unit {
  if !ok {
    abort("v121 gate failed: " + what)
  }
}

