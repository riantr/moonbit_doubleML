///|
/// The APO design emitted by the oracle. `d` is a hard threshold on the
/// score, so the linear propensity model is genuinely miscalibrated and
/// the isotonic gate has something to correct -- a fixture where the
/// propensity were already calibrated would make the end-to-end gate
/// vacuous.
fn v121_apo_data() -> DoubleMLData {
  DoubleMLData::new(Matrix::from_rows(v121_apo_x()), v121_apo_y(), v121_d())
}

///|
/// A config by name, matching the catalogue the oracle swept.
fn v121_config(tag : String) -> PSProcessorConfig raise PSConfigError {
  if tag == "no_calib_1e-2" {
    PSProcessorConfig::new(clipping_threshold=0.01)
  } else if tag == "no_calib_1e-6" {
    PSProcessorConfig::new(clipping_threshold=1.0e-6)
  } else if tag == "isotonic_1e-2" {
    PSProcessorConfig::new(
      clipping_threshold=0.01,
      calibration_method="isotonic",
    )
  } else if tag == "isotonic_1e-6" {
    PSProcessorConfig::new(
      clipping_threshold=1.0e-6,
      calibration_method="isotonic",
    )
  } else {
    PSProcessorConfig::new(
      clipping_threshold=0.01,
      calibration_method="isotonic",
      cv_calibration=true,
    ) catch {
      PSConfigError::InconsistentCVCalibration =>
        abort("v121_config: unreachable")
    }
  }
}

// ---------------------------------------------------------------------------
// GATE 1 -- init_ps_processor precedence, against upstream's own answers.
// ---------------------------------------------------------------------------

///|
test "v121_resolution_precedence" {
  // upstream: init_ps_processor(None, "truncate", 0.05) -> clip 0.05
  let a = resolve_ps_processor(
    ps_processor_config=None,
    trimming_threshold=0.05,
  )
  v121_expect(a.clipping_threshold() == 0.05, "scalar 0.05 becomes the clip")
  v121_expect(
    a.calibration_method() == "none",
    "no config means no calibration",
  )

  // upstream: init_ps_processor(None, "truncate", 0.2) -> clip 0.2
  let b = resolve_ps_processor(ps_processor_config=None, trimming_threshold=0.2)
  v121_expect(b.clipping_threshold() == 0.2, "scalar 0.2 becomes the clip")

  // upstream: init_ps_processor(cfg(0.3), "truncate", 0.05) -> clip 0.3
  // The 0.05 is IGNORED, not merged and not used as a fallback. This is
  // the non-obvious half and it is the thing a "merge both arguments"
  // implementation would get wrong.
  let cfg3 = PSProcessorConfig::new(clipping_threshold=0.3)
  let c = resolve_ps_processor(
    ps_processor_config=Some(cfg3),
    trimming_threshold=0.05,
  )
  v121_expect(c.clipping_threshold() == 0.3, "the config WINS over the scalar")

  // upstream: cfg(isotonic, 0.01) beats scalar 0.05, and the method
  // survives the resolution rather than being dropped.
  let cfg4 = PSProcessorConfig::new(
    clipping_threshold=0.01,
    calibration_method="isotonic",
  )
  let d = resolve_ps_processor(
    ps_processor_config=Some(cfg4),
    trimming_threshold=0.05,
  )
  v121_expect(d.clipping_threshold() == 0.01, "config clip wins")
  v121_expect(d.calibration_method() == "isotonic", "config method survives")
  v121_expect(d.cv_calibration() == false, "config cv survives")
}

///|
/// The stored config is concrete (never `None`), so handing a child
/// `Some(this)` is byte-identical to resolving again. APOS relies on
/// this.
test "v121_resolved_config_is_stable_under_re_resolution" {
  let src = PSProcessorConfig::new(
    clipping_threshold=0.02,
    calibration_method="isotonic",
    cv_calibration=true,
  ) catch {
    PSConfigError::InconsistentCVCalibration => abort("unreachable")
  }
  let once = resolve_ps_processor(
    ps_processor_config=Some(src),
    trimming_threshold=1.0e-6,
  )
  let twice = resolve_ps_processor(
    ps_processor_config=Some(
      resolve_ps_processor_config(
        ps_processor_config=Some(src),
        trimming_threshold=1.0e-6,
      ),
    ),
    trimming_threshold=1.0e-6,
  )
  v121_expect(
    once.clipping_threshold() == twice.clipping_threshold(),
    "clip is stable",
  )
  v121_expect(
    once.extreme_threshold() == twice.extreme_threshold(),
    "extreme is stable",
  )
  v121_expect(
    once.calibration_method() == twice.calibration_method(),
    "method is stable",
  )
  v121_expect(once.cv_calibration() == twice.cv_calibration(), "cv is stable")
}

///|
fn v121_check_adjust(tag : String, want : Array[Double]) -> Double {
  let ps = v121_ps_raw()
  let d = v121_d()
  let cfg = v121_config(tag) catch {
    PSConfigError::InconsistentCVCalibration =>
      abort(
        "v121_check_adjust: the oracle catalogue contains an invalid config",
      )
  }
  let got = PSProcessor::from_config(cfg).adjust_ps(ps, d)
  let gap = v121_max_abs_diff(got, want)
  v121_expect(
    gap <= 1.0e-6,
    "adjust_ps gap vs upstream for " + tag + " (got " + gap.to_string() + ")",
  )
  gap
}

// ---------------------------------------------------------------------------
// GATE 2 -- adjust_ps against upstream, for every config.
// ---------------------------------------------------------------------------

///|
test "v121_adjust_ps_matches_upstream" {
  let mut worst = 0.0
  let g0 = v121_check_adjust("no_calib_1e-2", v121_ref_0())
  if g0 > worst {
    worst = g0
  }
  let g1 = v121_check_adjust("no_calib_1e-6", v121_ref_1())
  if g1 > worst {
    worst = g1
  }
  let g2 = v121_check_adjust("isotonic_1e-2", v121_ref_2())
  if g2 > worst {
    worst = g2
  }
  let g3 = v121_check_adjust("isotonic_1e-6", v121_ref_3())
  if g3 > worst {
    worst = g3
  }
  // `isotonic_cv` is DELIBERATELY NOT in this parity gate. See the
  // note on v121_cv_calibration_parity_is_a_known_gap below.
  println("v121 adjust_ps worst gap vs upstream = " + worst.to_string())
}

// ---------------------------------------------------------------------------
// KNOWN GAP, measured rather than hidden.
//
// The four configurations above agree with upstream to 1e-6:
//   * no-calibration is the exact identity, then a pure clip
//   * full-sample isotonic agrees, so `fit_isotonic` / `pava` /
//     `predict_isotonic` match sklearn's `IsotonicRegression` to 1e-6
//     (and its STEP prediction rule matches its LINEAR interpolation
//     exactly on this fixture: 0.0 on the full fit and 0.0 on fold 0,
//     where 39 of 40 test points fall between knots).
//
// The cross-validated isotonic path does NOT agree. Measured gap after
// the v0.121.0 partition fix: 0.1056 (it was 0.24 before). The fix was
// real -- `default_5fold` used this package's SHUFFLED `kfold` while
// upstream's `cross_val_predict(cv=None)` is `KFold(5, shuffle=False)`,
// and the two partitions alone account for 0.14 inside sklearn.
//
// The residual is NOT the port's step-vs-linear rule (measured 0.0 on
// both the full fit and fold 0) and NOT the partition (fixed). It is
// inside sklearn's cross-validation machinery and is not yet explained.
//
// This is recorded rather than absorbed into a loose tolerance: a gate
// at 0.1 would catch nothing, and claiming parity here would be false.
// ---------------------------------------------------------------------------

///|
test "v121_cv_calibration_parity_is_a_known_gap" {
  let ps = v121_ps_raw()
  let d = v121_d()
  let got = PSProcessor::from_config(v121_config("isotonic_cv")).adjust_ps(
    ps, d,
  )
  let gap = v121_max_abs_diff(got, v121_ref_4())
  // The gap is real and large. Pinning it from ABOVE keeps this gate
  // meaningful: a future change that made the CV path WORSE would fail
  // here even though no parity gate covers it.
  v121_expect(gap > 1.0e-3, "the CV gap is still present (it is not 0)")
  v121_expect(gap < 0.2, "the CV gap did not regress past the partition fix")
  println("v121 CV-vs-upstream gap (known) = " + gap.to_string())
}

// ---------------------------------------------------------------------------
// GATE 3 -- without a calibration method the transform is EXACTLY the
// identity, then a pure clip. This is the gate that licenses the
// behaviour-preserving rewiring of the pre-existing clip site.
// ---------------------------------------------------------------------------

///|
test "v121_no_calibration_is_exact_identity" {
  let ps = v121_ps_raw()
  let d = v121_d()
  let out = PSProcessor::from_config(v121_config("no_calib_1e-2")).adjust_ps(
    ps, d,
  )
  // The fixture's interior propensities are all inside (1e-2, 1-1e-2),
  // so with no calibration the result must equal the input BIT FOR BIT.
  v121_expect(
    v121_max_abs_diff(out, ps) == 0.0,
    "no-calibration adjust_ps is exactly the identity on interior rows",
  )
  // And on the extreme fixture it is a pure clip: the two planted
  // out-of-range entries land exactly on the bounds.
  let ex = v121_ps_extreme()
  let oe = PSProcessor::from_config(v121_config("no_calib_1e-2")).adjust_ps(
    ex, d,
  )
  v121_expect(oe[0] == 0.01, "the planted 1e-9 clips up to the threshold")
  v121_expect(
    (oe[1] - (1.0 - 0.01)).abs() < 1.0e-15,
    "the planted 1-1e-9 clips down to 1 - threshold",
  )
}

// ---------------------------------------------------------------------------
// GATE 4 -- the calibration is not decorative. If isotonic produced the
// same answer, the whole feature would be a rename.
// ---------------------------------------------------------------------------

///|
test "v121_isotonic_moves_the_propensity" {
  let ps = v121_ps_extreme()
  let d = v121_d()
  let plain = PSProcessor::from_config(v121_config("no_calib_1e-2")).adjust_ps(
    ps, d,
  )
  let iso = PSProcessor::from_config(v121_config("isotonic_1e-2")).adjust_ps(
    ps, d,
  )
  // upstream moves this fixture by 0.526316; require the same order.
  let moved = v121_max_abs_diff(iso, plain)
  v121_expect(moved > 0.2, "isotonic moves the propensity materially")
  v121_expect(moved < 0.9, "isotonic does not move it to a degenerate value")
  println("v121 isotonic movement = " + moved.to_string())
}

///|
test "v121_cv_calibration_differs_from_full_sample_isotonic" {
  let ps = v121_ps_raw()
  let d = v121_d()
  let full = PSProcessor::from_config(v121_config("isotonic_1e-2")).adjust_ps(
    ps, d,
  )
  let cv = PSProcessor::from_config(v121_config("isotonic_cv")).adjust_ps(ps, d)
  // upstream: 0.422869 (full sample) vs 0.378237 (cv), i.e. the cv path
  // is a genuinely different estimator, not the same one twice.
  let moved = v121_max_abs_diff(full, cv)
  v121_expect(moved > 1.0e-3, "cv calibration is a different fit")
  println("v121 cv vs full-sample isotonic gap = " + moved.to_string())
}

///|
test "v121_isotonic_is_deterministic" {
  let ps = v121_ps_raw()
  let d = v121_d()
  let a = PSProcessor::from_config(v121_config("isotonic_cv")).adjust_ps(ps, d)
  let b = PSProcessor::from_config(v121_config("isotonic_cv")).adjust_ps(ps, d)
  v121_expect(v121_max_abs_diff(a, b) == 0.0, "cv isotonic is bit-reproducible")
}

///|
/// The config must survive the round trip through `fit`'s RETURN value.
///
/// `DoubleMLAPO::fit` rebuilds the model at its tail, and `fit_cluster`
/// and `DoubleMLAPOS::fit` do the same. Those three literals each carry
/// `ps_processor_config` forward. A mutation that replaced them with a
/// re-resolution from the scalar SURVIVED the isotonic end-to-end gate,
/// because `fit` had already used `self.ps_processor_config` to compute
/// the coefficient before rebuilding -- so the damage only appears on a
/// SECOND fit of the returned model, which is exactly what `tune` and
/// `set_sample_splitting` do.
///
/// Found by the mutation harness, not by reading the code.
test "v121_the_config_survives_a_refit_of_the_returned_model" {
  let iso = PSProcessorConfig::new(
    clipping_threshold=1.0e-6,
    calibration_method="isotonic",
  )
  let once = DoubleMLAPO::new(
    v121_apo_data(),
    n_folds=2,
    seed=3141,
    ps_processor_config=Some(iso),
  ).fit()
  let twice = once.fit()
  let plain = DoubleMLAPO::new(v121_apo_data(), n_folds=2, seed=3141).fit()
  v121_expect(
    (twice.coef() - plain.coef()).abs() > 1.0e-9,
    "a refit of the returned model keeps the calibration",
  )
  v121_expect(
    twice.coef() == once.coef(),
    "the refit is deterministic and unchanged",
  )
}

// ---------------------------------------------------------------------------
// GATE 5 -- upstream rejects cv_calibration without a method.
// ---------------------------------------------------------------------------

///|
test "panic_v121_cv_calibration_requires_a_method" {
  let _ = PSProcessorConfig::new(
    clipping_threshold=0.01,
    calibration_method="none",
    cv_calibration=true,
  )
}

// ---------------------------------------------------------------------------
// GATE 6 -- end to end. The clip site now runs through adjust_ps; with
// the default config that must be a NO-OP relative to the pre-v0.121.0
// inline clip, and with isotonic it must actually move the estimate.
// ---------------------------------------------------------------------------

///|
test "v121_apo_default_config_reproduces_the_pre_v121_number" {
  let plain = DoubleMLAPO::new(v121_apo_data(), n_folds=2, seed=3141).fit()
  // The scalar-only path and the explicit default-config path must
  // agree exactly: with `ps_processor_config=None` the resolution sets
  // clipping_threshold = propensity_clip and method = "none".
  let via_config = DoubleMLAPO::new(
    v121_apo_data(),
    n_folds=2,
    seed=3141,
    ps_processor_config=Some(PSProcessorConfig::new(clipping_threshold=1.0e-6)),
  ).fit()
  v121_expect(plain.coef() == via_config.coef(), "default config is a no-op")
}

///|
test "v121_apo_isotonic_config_changes_the_estimate" {
  let plain = DoubleMLAPO::new(v121_apo_data(), n_folds=2, seed=3141).fit()
  let iso = DoubleMLAPO::new(
    v121_apo_data(),
    n_folds=2,
    seed=3141,
    ps_processor_config=Some(
      PSProcessorConfig::new(
        clipping_threshold=1.0e-6,
        calibration_method="isotonic",
      ),
    ),
  ).fit()
  let d = (plain.coef() - iso.coef()).abs()
  v121_expect(d > 1.0e-9, "isotonic calibration reaches the APO coefficient")
  println(
    "v121 APO coef plain=" +
    plain.coef().to_string() +
    " isotonic=" +
    iso.coef().to_string(),
  )
}

///|
test "v121_apos_propagates_the_config_to_every_child" {
  let obj = v121_apo_data()
  let plain = DoubleMLAPOS::new(obj, [0.0, 1.0], n_folds=2, seed=3141).fit()
  let iso = DoubleMLAPOS::new(
    obj,
    [0.0, 1.0],
    n_folds=2,
    seed=3141,
    ps_processor_config=Some(
      PSProcessorConfig::new(
        clipping_threshold=1.0e-6,
        calibration_method="isotonic",
      ),
    ),
  ).fit()
  let mut moved = 0
  for i = 0; i < plain.coefs().length(); i = i + 1 {
    if (plain.coefs()[i] - iso.coefs()[i]).abs() > 1.0e-9 {
      moved = moved + 1
    }
  }
  v121_expect(moved > 0, "APOS passes the calibration down to its children")
}
